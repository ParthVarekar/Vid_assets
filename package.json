{
  "name": "protovinci-off-the-page",
  "version": "1.0.0",
  "description": "ProtoVinci brand film \"Off the Page\": Remotion source, score renderer and QA tools",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/fonts": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "@remotion/layout-utils": "4.0.543",
    "@remotion/media": "4.0.543",
    "@remotion/noise": "4.0.543",
    "@remotion/paths": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "potrace": "^2.1.8",
    "prettier": "3.8.1",
    "sharp": "^0.35.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/assets/trace-logo.mjs && node scripts/assets/make-textures.mjs",
    "audio": "node --no-warnings scripts/audio/render-score.mjs",
    "audio:check": "node scripts/qa/audio-check.mjs public/assets/audio/score-master.wav && node scripts/qa/audio-check.mjs public/assets/audio/score-cutdown.wav",
    "render": "node scripts/render-all.mjs",
    "render:master": "node scripts/render-all.mjs Master-16x9",
    "qa:stills": "node scripts/qa/review-stills.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
